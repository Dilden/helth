{
	"name": "helth.app",
	"version": "1.0.10",
	"scripts": {
		"cloud": "dexie-cloud",
		"dev": "vite dev --host",
		"build": "vite build",
		"package": "vite package",
		"preview:ssl": "vite preview --host --port=3001",
		"preview": "vite preview --host",
		"test": "playwright test && npm run test:unit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. . && prettier --write ."
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@testing-library/user-event": "^14.4.3",
		"@types/eslint__js": "^8.42.3",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@zxing/library": "^0.23.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.0.0",
		"jsdom": "^29.1.1",
		"picomatch": "^4.0.3",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.6.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"type": "module",
	"dependencies": {
		"chart.js": "^4.3.3",
		"chartjs-plugin-annotation": "^3.0.1",
		"dexie": "^4.4.3",
		"dexie-cloud": "^3.0.4",
		"dexie-cloud-addon": "^4.4.13",
		"dexie-export-import": "^4.4.0",
		"stripe": "^18.3.0"
	},
	"jest": {
		"setupFilesAfterEnv": [
			"@testing-library/jest-dom/extend-expect"
		]
	},
	"overrides": {
		"picomatch": "^4.0.3"
	}
}
